# Budget local-dev environment. Names only; real values are never committed.
# Copy to .env and fill in, or render with 1Password once a template exists.
# Empty values count as unset. Read ONLY by the entrypoints (api/src/index.ts,
# worker.ts, cli.ts, mcp.ts) and the scripts; features receive injected config.

# ---- Database -------------------------------------------------------------
# Postgres connection string. Local dev: a budgetnew_dev database (host 5432
# or the compose Postgres on 55432), e.g. postgres://postgres:<password>@127.0.0.1:55432/budgetnew_dev
DATABASE_URL=
# Compose Postgres superuser password (docker-compose.yml, host port 55432).
POSTGRES_PASSWORD=

# ---- API (api/src/index.ts) ------------------------------------------------
# Listen port (default 3100).
API_PORT=
# Bind address (default all interfaces; set 127.0.0.1 to narrow).
API_HOST=
# Comma-separated extra CORS origins (the admin SPA, e.g. https://budget-admin.syscd.live).
ADMIN_ORIGIN=
# Budget repeat-rule tick: set 0/false/off to disable it (default on). Turn it
# off on whichever API should NOT generate occurrences while two APIs share a DB.
BUDGET_REPEAT_TICK=
# Repeat-rule tick interval in seconds (default 86400).
BUDGET_REPEAT_INTERVAL_SECONDS=

# ---- Auth (api/src/auth-env.ts builds the injected config) ----------------
# Refuse-to-boot guard: a sign-in provider must be fully configured (Access:
# ACCESS_TEAM_DOMAIN + ACCESS_AUD; Google: GOOGLE_CLIENT_ID +
# GOOGLE_CLIENT_SECRET + AUTH_ALLOWED_EMAILS) plus SESSION_SECRET, unless this
# is exactly 1, which allows auth-off LOCAL dev (and is refused in a cluster
# and ignored when any auth var is set). Never set it on a deployment.
AUTH_DISABLED_OK=
# Comma-separated e-mails allowed to sign in. Required for Google; optional
# extra check with Access (unset = whoever the Cloudflare policy admits).
AUTH_ALLOWED_EMAILS=
# E-mail + password sign-in (/auth/password/*), on by default whenever auth
# is on. 0/false/off/no turns the routes into 404 and makes every existing
# password session invalid; any other unknown value refuses to boot.
AUTH_PASSWORD_LOGIN=
# Google OAuth client for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Access sign-in (/auth/access). Both set = Access is a provider;
# one without the other refuses to boot. Team domain without scheme, e.g.
# syscd.cloudflareaccess.com. With Access on and AUTH_ALLOWED_EMAILS unset,
# the Cloudflare policy is the only allow-list.
ACCESS_TEAM_DOMAIN=
# Comma-separated AUD tags of the Access application(s) gating /auth/access
# (web and native may use different applications).
ACCESS_AUD=
# DEV/TEST ONLY: JWKS URL replacing https://<team>/cdn-cgi/access/certs (a
# local fake signer). Refused when KUBERNETES_SERVICE_HOST is set.
ACCESS_CERTS_URL=
# HMAC key for session JWTs and OAuth tokens; at least 32 characters.
SESSION_SECRET=
# Session lifetime in days (default 30).
SESSION_TTL_DAYS=
# Session cookie domain (default .syscd.live; cookie name is budget_session).
COOKIE_DOMAIN=
# Web app origin for post-login redirects (default https://budget.syscd.live).
APP_BASE_URL=
# Public API origin: OAuth issuer and Google redirect URIs (default https://budget-api.syscd.live).
API_BASE_URL=
# Machine-to-machine bearer for agent clients; empty disables that lane.
OT_SERVICE_TOKEN=
# Set by Kubernetes; makes the auth guard strict and refuses AUTH_DISABLED_OK.
KUBERNETES_SERVICE_HOST=

# ---- Temporal / jobs (api/src/index.ts, worker.ts) -------------------------
# Temporal gRPC address (default localhost:7233; compose dev server: localhost:57233).
TEMPORAL_ADDRESS=
# Temporal namespace (default `default`; `budget` in production).
TEMPORAL_NAMESPACE=
# Task queue (default budget-jobs).
TEMPORAL_TASK_QUEUE=
# Temporal Web UI base URL, linked from the jobs admin.
TEMPORAL_UI_URL=
# Environment/deployment id stamped on job runs; the relay only takes runs
# carrying ITS id (default budget-local). Must differ from syscd's while both share a DB.
JOBS_INSTANCE_ID=

# ---- Bank connections: Pluggy (connections feature, via configurePluggyEnv) -
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Pluggy API base (default https://api.pluggy.ai).
PLUGGY_BASE_URL=
# true/false (default true).
PLUGGY_SANDBOX=
# Comma-separated item ids (optional).
PLUGGY_ITEM_IDS=
# Pluggy clientUserId (default syscd-app; kept so existing Pluggy items stay attached).
CLIENT_USER_ID=
# Shared secret Pluggy sends on webhooks (unset = webhooks rejected).
PLUGGY_WEBHOOK_SECRET=

# ---- Own bank-provider keys (api/src/secrets-env.ts, core/secret-box.ts) -----
# Master key that encrypts users' own Pluggy client secrets at rest (AES-256-GCM,
# table public.connection_credentials). 32 random bytes as base64, or 64 hex
# characters: `openssl rand -base64 32`. The API and the worker need the SAME
# value. Required in a cluster (boot fails without it); locally optional (unset
# = saving and using own keys answers 503 credentials_key_missing). Changing or
# losing it makes stored secrets unreadable: users then save their keys again.
CREDENTIALS_ENCRYPTION_KEY=

# ---- AI keys: category suggestions (api/src/ai, via configureAiEnv) ---------
# The installation's SHARED AI key. Empty = no shared key; feature
# 'shared-ai-key' then cannot give anyone AI. A user's own key is saved per user
# in public.ai_credentials (sealed with CREDENTIALS_ENCRYPTION_KEY above).
AI_SHARED_API_KEY=
# Provider of AI_SHARED_API_KEY: openrouter | anthropic | openai | zai | deepseek.
# Empty = detected from the key's shape; Z.ai keys have no documented shape,
# so a shared Z.ai key must set this to zai.
AI_SHARED_PROVIDER=
# Default model for the shared key; app_settings.aiSharedModel overrides it.
AI_SHARED_MODEL=

# ---- CLI / MCP stdio (api/src/cli.ts, mcp.ts) ------------------------------
# API base URL the CLI and stdio MCP talk to (default http://localhost:3100); API_URL is the fallback name.
BUDGET_API_URL=
API_URL=
# Credentials live in $XDG_CONFIG_HOME/budget/credentials.json (default ~/.config/budget/).
XDG_CONFIG_HOME=

# ---- Tests and e2e scripts (api/scripts) -----------------------------------
# Make DB-backed suites fail (instead of skip) when the test DB is unavailable.
BUDGET_REQUIRE_TEST_DB=
# Explicit test DB name; must match budgetnew_test[a-z0-9_]* (default budgetnew_test[_<hash>] per worktree).
BUDGET_TEST_DB=
# Postgres base URL for the test DB (default postgres://postgres:postgres@localhost:5432).
BUDGET_TEST_PG_BASE=
# e2e-consent / e2e-mcp inputs.
E2E_EMAIL=
E2E_DECISION=
E2E_BUDGET_ID=
E2E_ACCOUNT_ID=

# ---- Expo app --------------------------------------------------------------
# Expo app -> API base URL, e.g. http://localhost:3100
EXPO_PUBLIC_API_URL=
