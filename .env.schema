# Budget local-dev environment. Names only; real values are never committed.
# Copy to .env and fill in, or render with 1Password once a template exists.

# Postgres from docker-compose.yml (host port 55432).
# e.g. postgres://postgres:<password>@127.0.0.1:55432/budget
DATABASE_URL=
POSTGRES_PASSWORD=

# API bind (api/src/index.ts). Default port 3100.
API_PORT=

# Temporal dev server from docker-compose.yml (host port 57233).
TEMPORAL_ADDRESS=

# Expo app -> API base URL, e.g. http://localhost:3100
EXPO_PUBLIC_API_URL=
