# Budget web image: Expo web export of client/, served by busybox httpd on :8080
# with an SPA fallback (deploy/httpd.conf). Build context is the REPO ROOT:
#   docker build -f deploy/Dockerfile.web -t budget-web .
#   docker build -f deploy/Dockerfile.web --build-arg EXPO_PUBLIC_API_URL=https://... -t budget-web .

# ---- Build stage --------------------------------------------------------------
FROM --platform=$BUILDPLATFORM oven/bun:1.4.4-alpine AS build
WORKDIR /app

# The expo CLI is a node program (shebang `#!/usr/bin/env node`) and loads
# app.config.ts through node's type stripping; it dies under bun's runtime.
# Node is only needed in this stage; the serve stage is busybox.
RUN apk add --no-cache nodejs

# CI=1 + EXPO_NO_TELEMETRY=1: non-interactive, no telemetry network calls.
ENV CI=1 EXPO_NO_TELEMETRY=1 EXPO_NO_DEPENDENCY_VALIDATION=1 NODE_OPTIONS=--max-old-space-size=6144

# shared/ first: it owns zod, and client/ overrides zod to
# link:../shared/node_modules/zod, so shared/node_modules must exist before
# client installs.
COPY shared/package.json shared/bun.lock shared/bunfig.toml shared/
RUN cd shared && bun install --frozen-lockfile --production
COPY client/package.json client/bun.lock client/bunfig.toml client/
RUN cd client && bun install --frozen-lockfile

COPY shared shared
COPY client client

# Baked into the static bundle at export time (EXPO_PUBLIC_* is inlined).
ARG EXPO_PUBLIC_API_URL=https://budget-api.syscd.live
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

# `expo export` exits on its own here; no `timeout ... || true` wrapper. If a
# future SDK hangs on exit, fail the build instead of masking a bad export.
RUN cd client && bunx expo export --platform web --output-dir dist \
    && test -f dist/index.html

# ---- Serve stage --------------------------------------------------------------
FROM busybox:1.38 AS serve

RUN adduser -D -u 10001 -H app

COPY --from=build /app/client/dist /www
COPY deploy/httpd.conf /etc/httpd.conf

USER app
EXPOSE 8080

CMD ["busybox", "httpd", "-f", "-v", "-p", "0.0.0.0:8080", "-h", "/www", "-c", "/etc/httpd.conf"]
